# ==================================================================
# Hawlai environment variables — complete reference.
# ==================================================================
# Every variable this codebase reads, generated from all 55
# `process.env.*` references in src/ and scripts/. Audit item R8:
# previously 9 of 55 were documented, so provisioning an environment
# meant reading the source.
#
# NO REAL VALUES BELONG IN THIS FILE. It is committed.
#
# REQUIRED  the app does not work without it
# CORE      a whole product area is dark without it
# OPTIONAL  one feature degrades; the rest is unaffected
# INACTIVE  code exists but the integration is not live yet
#
# The distinction matters at deploy time: a missing REQUIRED breaks
# everything loudly, while a missing CORE or OPTIONAL usually breaks
# one thing QUIETLY — which is how the meta-leads webhook and the
# commerce backfill both nearly shipped broken.
# ==================================================================


# ---- REQUIRED: database and auth ---------------------------------
# Without these nothing runs, including the build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS entirely — the most powerful credential here. Used by
# webhooks, cron jobs and the maintenance scripts. Never expose it to
# a browser, and rotate it if it is ever pasted anywhere.
SUPABASE_SERVICE_ROLE_KEY=

# ---- REQUIRED: AI ------------------------------------------------
# Every agent, Master Chat, and all content generation. The product is
# inert without it.
ANTHROPIC_API_KEY=

# ---- REQUIRED: public site URL -----------------------------------
# Used to build absolute links in emails, feeds and OAuth redirects.
# A wrong value produces links that resolve to the wrong environment.
NEXT_PUBLIC_SITE_URL=


# ==================================================================
# CORE integrations — a product area goes dark without these
# ==================================================================

# ---- Meta: ads, lead ingestion, page connection ------------------
# FACEBOOK_APP_SECRET is also what verifies webhook payload
# signatures. The meta-leads and meta-messaging webhooks FAIL CLOSED
# without it: leads stop arriving, silently from the dealer's side.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Echoed back during Meta's webhook subscription handshake.
META_WEBHOOK_VERIFY_TOKEN=
# Platform-level fallbacks, used only when a dealership has not
# connected its own Page. Per-dealership credentials live in the
# dealerships table and take precedence.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_LEAD_FORM_ID=
# Fallback owner for an inbound lead whose Page matches no dealership.
META_DEFAULT_DEALERSHIP_ID=

# ---- Instagram (separate app from Facebook) ----------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- Google OAuth: Gmail, Google Ads, YouTube --------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- WhatsApp (Gupshup) ------------------------------------------
GUPSHUP_API_KEY=
GUPSHUP_SOURCE_NUMBER=

# ---- Voice calling (Vapi) ----------------------------------------
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# ---- Transactional email (Resend) --------------------------------
RESEND_API_KEY=

# ---- Cron authentication -----------------------------------------
# Vercel sends this as a Bearer token on scheduled invocations. If it
# is UNSET the daily-run endpoint still works but is publicly
# triggerable — it logs a warning rather than refusing, so an
# unprotected cron endpoint is easy to miss.
CRON_SECRET=


# ==================================================================
# Encryption at rest
# ==================================================================
# 32 bytes each, hex or base64:  openssl rand -hex 32
#
# Separate keys by blast radius. Losing the Canva key forces every
# user to reconnect; losing the commerce key breaks checkout for every
# merchant. You may set both to the same VALUE, but separate names
# keep them independently rotatable.
CANVA_TOKEN_ENCRYPTION_KEY=
COMMERCE_ENCRYPTION_KEY=

# Set ONLY during a key rotation, and remove afterwards. See the
# procedure in scripts/rekey-secrets.ts — removing these before the
# re-key script reports zero remaining strands every value not yet
# migrated, with no way back.
CANVA_TOKEN_ENCRYPTION_KEY_PREVIOUS=
COMMERCE_ENCRYPTION_KEY_PREVIOUS=


# ==================================================================
# Feature kill switches
# ==================================================================
# Default OFF: anything other than the exact string "true" — including
# absent — reads as disabled, so a missing variable cannot leave a
# retired feature live. Both are currently OFF; Canva Design & Edit
# replaced them. Changing these needs a redeploy, not a code change.
NEXT_PUBLIC_VIDEO_GENERATION_ENABLED=false
NEXT_PUBLIC_STUDIO_3D_ENABLED=false

# Makes every plan-gating check resolve as allowed, without changing
# what plan an account is on. For demos and testing. It does NOT
# override the kill switches above — a switched-off feature stays off.
BYPASS_PLAN_GATING=


# ==================================================================
# OPTIONAL — one feature degrades, the rest is unaffected
# ==================================================================

# ---- Canva Design & Edit -----------------------------------------
# The redirect URI must match what is registered at canva.com/developers
# exactly, including scheme and path. Return navigation is configured
# separately in Canva's portal and points at /api/canva/return.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=

# ---- RAG knowledge base ------------------------------------------
# Master Chat degrades gracefully without this: it keeps working and
# simply stops drawing on the marketing knowledge base. Silent, so its
# absence is easy to mistake for the model being unhelpful.
VOYAGE_API_KEY=

# ---- Media generation --------------------------------------------
ELEVENLABS_API_KEY=
RUNWAY_API_KEY=
GEMINI_API_KEY=
# Stock photography for generated content.
PEXELS_API_KEY=

# ---- Google Business reviews -------------------------------------
GOOGLE_PLACES_API_KEY=

# ---- Domain purchase and DNS (ResellerClub) ----------------------
RESELLERCLUB_API_KEY=
RESELLERCLUB_RESELLER_ID=

# ---- Custom domain attachment (Vercel API) -----------------------
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=


# ==================================================================
# INACTIVE — code exists, integration not live
# ==================================================================
# Each is blocked on an external approval or registration rather than
# on code. Setting them activates paths that have never run against a
# live API.

# Requires an approved Google Ads developer token.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Each requires its own app registration and review.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# Deep research. No key obtained yet.
PERPLEXITY_API_KEY=


# ==================================================================
# Maintenance — set only while running a specific script
# ==================================================================
# One-time knowledge base seeding, /api/admin/seed-knowledge.
ADMIN_SEED_SECRET=
# One-time website block migration endpoint.
MIGRATE_BLOCKS_SECRET=
