NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---- Feature kill switches (src/lib/featureFlags.ts) ----
# Global on/off, independent of plan gating. Default is OFF: anything
# other than the exact string "true" — including absent — reads as
# disabled, so a missing variable can't leave a retired feature live.
# Both are currently OFF; Design & Edit (Canva) replaces them.
# Changing these needs a redeploy (Vercel bakes env vars at build time),
# but no code change.
NEXT_PUBLIC_VIDEO_GENERATION_ENABLED=false
NEXT_PUBLIC_STUDIO_3D_ENABLED=false

# ---- Canva Connect (Design & Edit) ----
# From canva.com/developers. The redirect URI must match what's
# registered there exactly, including scheme and trailing path.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=https://your-domain/api/canva/oauth/callback
# 32 bytes for AES-256-GCM, hex or base64. Generate with:
#   openssl rand -hex 32
# Canva tokens only — the other OAuth providers still store plaintext.
# Changing this makes every stored Canva connection unreadable and
# forces every user to reconnect, so treat it as permanent.
CANVA_TOKEN_ENCRYPTION_KEY=

# ---- Commerce & payment secret encryption (src/lib/crypto/secretCrypto.ts) ----
# 32 bytes, hex or base64:  openssl rand -hex 32
# Encrypts razorpay_key_secret, shopify_access_token and
# woocommerce_consumer_secret at rest. SEPARATE from the Canva key so
# the two can be rotated independently — losing the Canva key forces
# reconnects, losing this one breaks checkout for every merchant. You
# may set both to the same value if you prefer one secret to manage.
# Treat as permanent: there is no re-key path yet.
COMMERCE_ENCRYPTION_KEY=

# ---- Key rotation (optional; set ONLY during a rotation) ----
# See scripts/rekey-secrets.ts for the full procedure. Set the
# retiring key here, deploy, run the re-key script, confirm zero
# remaining, then REMOVE these and deploy again. Removing them before
# the script reports zero strands every value not yet re-keyed.
CANVA_TOKEN_ENCRYPTION_KEY_PREVIOUS=
COMMERCE_ENCRYPTION_KEY_PREVIOUS=
